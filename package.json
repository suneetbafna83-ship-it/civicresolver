{
  "name": "civicresolve-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite",
    "dev:api": "tsx watch server/devServer.ts",
    "start:api": "tsx server/devServer.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --exclude \"tests/e2e/**\"",
    "test:e2e": "vitest run tests/e2e",
    "build": "tsc --noEmit",
    "build:ui": "vite build"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vis.gl/react-google-maps": "^1.10.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "jsdom": "^31.0.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
