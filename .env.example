# ==============================================================================
# CivicResolve Environment Configuration (Example Template)
# Copy to .env for local development. NEVER commit .env or real secrets.
# ==============================================================================

# --- Server-Only AI & API Runtime (NEVER expose via client Vite prefix) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
STRICT_AUTH_LOCKDOWN=false

# --- Client-Safe Firebase Spark Plan Web SDK (Project: civic-sense-43d74) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=civic-sense-43d74
VITE_FIREBASE_APP_ID=

# --- Client-Safe Google Maps Platform Demo Key (Auto-Failover to OpenStreetMap if blank) ---
VITE_GOOGLE_MAPS_API_KEY=
